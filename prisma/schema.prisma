generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model usuarios {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                 String                   @db.VarChar(120)
  correo                 String                   @unique @db.VarChar(160)
  password_hash          String                   @db.VarChar(255)
  rol                    String                   @default("admin") @db.VarChar(40)
  activo                 Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  movimientos_inventario inventario_movimientos[]
  reconteos              inventario_reconteos[]
  pedidos_devueltos      pedidos[]                @relation("pedidos_devuelto_porTousuarios")
  pedidos_entregados     pedidos[]                @relation("pedidos_entregado_porTousuarios")
  rutas_asignadas        rutas[]
  jornadas_visita        jornadas_visita[]
  visitas                visitas[]
}

model empleados {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre     String   @db.VarChar(120)
  cargo      String?  @db.VarChar(80)
  telefono   String?  @db.VarChar(40)
  activo     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  rutas      rutas[]
}

model rutas {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String     @db.VarChar(100)
  descripcion   String?
  empleado_id   String?    @db.Uuid
  activa        Boolean    @default(true)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  dias_semana   Int[]      @default([]) @db.SmallInt
  frecuencia    String     @default("semanal") @db.VarChar(20)
  fecha_base    DateTime?  @db.Date
  repartidor_id String?    @db.Uuid
  clientes      clientes[]
  pedidos       pedidos[]
  empleado      empleados? @relation(fields: [empleado_id], references: [id], onUpdate: NoAction)
  repartidor    usuarios?  @relation(fields: [repartidor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([repartidor_id], map: "idx_rutas_repartidor")
}

model clientes {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre            String               @db.VarChar(160)
  telefono          String               @unique @db.VarChar(40)
  direccion         String?
  ruta_id           String?              @db.Uuid
  activo            Boolean              @default(true)
  notas             String?
  created_at        DateTime             @default(now()) @db.Timestamptz(6)
  updated_at        DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  codigo_mekano     String?              @unique @db.VarChar(40)
  orden_ruta        Int?
  razon_social      String?              @db.VarChar(200)
  nit               String?              @db.VarChar(30)
  latitud           Float?
  longitud          Float?
  cliente_contactos cliente_contactos[]
  ruta              rutas?               @relation(fields: [ruta_id], references: [id], onUpdate: NoAction)
  conversaciones    conversaciones_wpp[]
  pedidos           pedidos[]
  pqrs              Pqr[]
  precios_cliente   precios_cliente[]
  sedes             sedes[]
  visitas           visitas[]

  @@index([codigo_mekano], map: "idx_clientes_codigo_mek")
  @@index([nit], map: "idx_clientes_nit")
  @@index([ruta_id], map: "idx_clientes_ruta")
  @@index([telefono], map: "idx_clientes_telefono")
}

model categorias {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String      @db.VarChar(100)
  slug        String      @unique @db.VarChar(50)
  emoji       String?     @db.VarChar(10)
  descripcion String?     @db.VarChar(200)
  orden       Int         @default(0)
  activa      Boolean     @default(true)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  productos   productos[]

  @@index([slug], map: "idx_categorias_slug")
}

model productos {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String            @db.VarChar(140)
  descripcion     String?
  imagen_url      String?
  unidad          String            @default("unidad") @db.VarChar(30)
  precio_base     Decimal           @default(0) @db.Decimal(12, 2)
  activo          Boolean           @default(true)
  orden           Int               @default(0)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  categoria_id    String?           @db.Uuid
  nombre_corto    String?           @db.VarChar(24)
  destacado       Boolean           @default(false)
  orden_destacado Int?
  inventario      inventario?
  inventario_item inventario_items?
  pedido_items    pedido_items[]
  precios_cliente precios_cliente[]
  categoria       categorias?       @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([categoria_id], map: "idx_productos_categoria")
  @@index([orden_destacado], map: "idx_productos_destacado")
}

model precios_cliente {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cliente_id  String    @db.Uuid
  producto_id String    @db.Uuid
  precio      Decimal   @db.Decimal(12, 2)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  cliente     clientes  @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  producto    productos @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cliente_id, producto_id])
  @@index([cliente_id], map: "idx_precios_cliente_cli")
  @@index([producto_id], map: "idx_precios_cliente_prod")
}

model pedidos {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cliente_id            String               @db.Uuid
  ruta_id               String?              @db.Uuid
  estado                String               @default("pendiente") @db.VarChar(30)
  total                 Decimal              @default(0) @db.Decimal(12, 2)
  fecha_pedido          DateTime             @default(dbgenerated("CURRENT_DATE")) @db.Date
  confirmado_at         DateTime?            @db.Timestamptz(6)
  notas                 String?
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  updated_at            DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  entregado_at          DateTime?            @db.Timestamptz(6)
  entregado_por         String?              @db.Uuid
  devolucion_motivo     String?
  devuelto_at           DateTime?            @db.Timestamptz(6)
  devuelto_por          String?              @db.Uuid
  sede_id               String?              @db.Uuid
  conversaciones        conversaciones_wpp[]
  items                 pedido_items[]
  cliente               clientes             @relation(fields: [cliente_id], references: [id], onUpdate: NoAction)
  devuelto_por_usuario  usuarios?            @relation("pedidos_devuelto_porTousuarios", fields: [devuelto_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entregado_por_usuario usuarios?            @relation("pedidos_entregado_porTousuarios", fields: [entregado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ruta                  rutas?               @relation(fields: [ruta_id], references: [id], onUpdate: NoAction)
  sede                  sedes?               @relation(fields: [sede_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cliente_id], map: "idx_pedidos_cliente")
  @@index([estado], map: "idx_pedidos_estado")
  @@index([fecha_pedido], map: "idx_pedidos_fecha")
  @@index([sede_id], map: "idx_pedidos_sede")
}

model pedido_items {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedido_id       String    @db.Uuid
  producto_id     String    @db.Uuid
  producto_nombre String    @db.VarChar(140)
  cantidad        Decimal   @db.Decimal(12, 2)
  precio_unitario Decimal   @db.Decimal(12, 2)
  subtotal        Decimal   @db.Decimal(12, 2)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  pedido          pedidos   @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  producto        productos @relation(fields: [producto_id], references: [id], onUpdate: NoAction)

  @@index([pedido_id], map: "idx_pedido_items_pedido")
}

model inventario {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producto_id  String    @unique @db.Uuid
  stock_actual Decimal   @default(0) @db.Decimal(12, 2)
  stock_minimo Decimal   @default(0) @db.Decimal(12, 2)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  producto     productos @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model conversaciones_wpp {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cliente_id         String?   @db.Uuid
  telefono           String    @db.VarChar(40)
  estado_flujo       String    @default("inicio") @db.VarChar(50)
  carrito            Json?     @default("[]")
  pedido_id          String?   @db.Uuid
  ultimo_mensaje_at  DateTime  @default(now()) @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  ultimo_mensaje_id  String?   @db.VarChar(100)
  producto_pendiente String?   @db.Uuid
  fecha_entrega      DateTime? @db.Date
  pqr_texto          String?
  pqr_adjuntos       Json?     @default("[]")
  sede_id            String?   @db.Uuid
  nit_temporal       String?   @db.VarChar(40)
  cliente            clientes? @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pedido             pedidos?  @relation(fields: [pedido_id], references: [id], onUpdate: NoAction)

  @@index([telefono], map: "idx_conv_telefono")
}

model configuracion {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre_negocio        String   @default("Productos Jalil") @db.VarChar(160)
  nit                   String?  @db.VarChar(40)
  direccion             String?
  telefono              String?  @db.VarChar(40)
  hora_recordatorio     DateTime @default(dbgenerated("'07:00:00'::time without time zone")) @db.Time(6)
  horas_espera_followup Int      @default(3) @db.SmallInt
  mensaje_recordatorio  String   @default("¡Hola! 👋 Es momento de hacer tu pedido para mañana. ¿Deseas realizar tu pedido hoy?")
  mensaje_followup      String   @default("🔔 Recordatorio: aún no hemos recibido tu pedido. ¿Deseas realizarlo ahora?")
  whatsapp_atencion     String?  @db.VarChar(20)
  updated_at            DateTime @default(now()) @db.Timestamptz(6)
}

model tienda_login_intentos {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clave      String   @db.VarChar(120)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([clave, created_at], map: "idx_tienda_login_intentos_clave")
}

model inventario_items {
  id                     String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                 String                         @db.VarChar(160)
  /// "insumo" | "materia_prima" | "producto_terminado"
  tipo                   tipo_inventario
  unidad                 String                         @default("kg") @db.VarChar(30)
  stock_actual           Decimal                        @default(0) @db.Decimal(12, 2)
  stock_minimo           Decimal                        @default(0) @db.Decimal(12, 2)
  costo_unitario         Decimal                        @default(0) @db.Decimal(12, 2)
  proveedor              String?                        @db.VarChar(120)
  tipo_animal            String?                        @db.VarChar(60)
  requiere_refrigeracion Boolean                        @default(false)
  fecha_vencimiento      DateTime?                      @db.Date
  producto_id            String?                        @unique @db.Uuid
  activo                 Boolean                        @default(true)
  created_at             DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                       @default(now()) @updatedAt @db.Timestamptz(6)
  producto               productos?                     @relation(fields: [producto_id], references: [id], onUpdate: NoAction)
  movimientos            inventario_movimientos[]
  recetas_insumo         inventario_recetas[]           @relation("receta_insumo")
  recetas_producto       inventario_recetas[]           @relation("receta_producto_terminado")
  reconteo_detalles      inventario_reconteo_detalles[]

  @@index([tipo], map: "idx_inv_items_tipo")
  @@index([activo], map: "idx_inv_items_activo")
  @@index([producto_id], map: "idx_inv_items_prod")
}

model inventario_movimientos {
  id                String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id           String                        @db.Uuid
  /// "entrada" | "salida" | "ajuste"
  tipo              tipo_movimiento
  /// "compra" | "venta" | "merma" | "produccion" | "ajuste_manual" | "reconteo"
  motivo            motivo_movimiento             @default(ajuste_manual)
  cantidad          Decimal                       @db.Decimal(12, 2)
  cantidad_anterior Decimal                       @db.Decimal(12, 2)
  cantidad_nueva    Decimal                       @db.Decimal(12, 2)
  notas             String?
  usuario_id        String?                       @db.Uuid
  created_at        DateTime                      @default(now()) @db.Timestamptz(6)
  /// Tipo de origen que generó el movimiento, ej: "produccion" | "reconteo"
  referencia_tipo   String?                       @db.VarChar(30)
  referencia_id     String?                       @db.Uuid
  item              inventario_items              @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario           usuarios?                     @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)
  reconteo_detalle  inventario_reconteo_detalles?

  @@index([item_id], map: "idx_inv_mov_item")
  @@index([tipo], map: "idx_inv_mov_tipo")
  @@index([created_at], map: "idx_inv_mov_fecha")
  @@index([usuario_id], map: "idx_inv_mov_usuario")
  @@index([referencia_tipo, referencia_id], map: "idx_movimientos_referencia")
}

model inventario_recetas {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producto_terminado_id String           @db.Uuid
  insumo_id             String           @db.Uuid
  cantidad_requerida    Decimal          @db.Decimal(12, 4)
  activo                Boolean          @default(true)
  created_at            DateTime         @default(now()) @db.Timestamp(6)
  updated_at            DateTime         @default(now()) @updatedAt @db.Timestamp(6)
  insumo                inventario_items @relation("receta_insumo", fields: [insumo_id], references: [id], onUpdate: NoAction)
  producto_terminado    inventario_items @relation("receta_producto_terminado", fields: [producto_terminado_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([producto_terminado_id, insumo_id])
  @@index([producto_terminado_id], map: "idx_recetas_producto")
}

model inventario_reconteos {
  id            String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha         DateTime                       @default(now()) @db.Timestamp(6)
  usuario_id    String?                        @db.Uuid
  nota_general  String?
  /// "abierto" | "confirmado" | "anulado"
  estado        String                         @default("abierto") @db.VarChar(20)
  created_at    DateTime                       @default(now()) @db.Timestamp(6)
  confirmado_at DateTime?                      @db.Timestamp(6)
  detalles      inventario_reconteo_detalles[]
  usuario       usuarios?                      @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)
}

model inventario_reconteo_detalles {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reconteo_id      String                  @db.Uuid
  item_id          String                  @db.Uuid
  cantidad_sistema Decimal                 @db.Decimal(12, 4)
  cantidad_fisica  Decimal                 @db.Decimal(12, 4)
  diferencia       Decimal?                @default(dbgenerated("(cantidad_fisica - cantidad_sistema)")) @db.Decimal(12, 4)
  nota             String?
  movimiento_id    String?                 @unique @db.Uuid
  created_at       DateTime                @default(now()) @db.Timestamp(6)
  item             inventario_items        @relation(fields: [item_id], references: [id], onUpdate: NoAction)
  movimiento       inventario_movimientos? @relation(fields: [movimiento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reconteo         inventario_reconteos    @relation(fields: [reconteo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([reconteo_id], map: "idx_reconteo_detalles_reconteo")
}

model mensajes_procesados_wpp {
  mensaje_id String   @id @db.VarChar(100)
  telefono   String?  @db.VarChar(40)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_mensajes_procesados_created")
}

model Pqr {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId     String?   @map("cliente_id") @db.Uuid
  telefono      String    @db.VarChar(20)
  clienteNombre String?   @map("cliente_nombre") @db.VarChar(140)
  texto         String?
  adjuntos      Json?     @default("[]")
  estado        String    @default("pendiente") @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  cliente       clientes? @relation(fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([clienteId], map: "idx_pqrs_cliente")
  @@index([createdAt(sort: Desc)], map: "idx_pqrs_created_at")
  @@index([estado], map: "idx_pqrs_estado")
  @@map("pqrs")
}

model sedes {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cliente_id   String    @db.Uuid
  nombre_sede  String    @db.VarChar(120)
  direccion    String?
  latitud      Float?
  longitud     Float?
  es_principal Boolean   @default(false)
  activa       Boolean   @default(true)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  pedidos      pedidos[]
  cliente      clientes  @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([cliente_id], map: "idx_sedes_cliente")
}

model cliente_contactos {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cliente_id String   @db.Uuid
  telefono   String   @db.VarChar(40)
  nombre     String?  @db.VarChar(160)
  principal  Boolean  @default(false)
  verificado Boolean  @default(false)
  origen     String   @default("manual") @db.VarChar(30)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  clientes   clientes @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([telefono, cliente_id], map: "idx_contactos_tel_cliente")
  @@index([cliente_id], map: "idx_contactos_cliente")
  @@index([telefono], map: "idx_contactos_telefono")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contactos_pendientes {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telefono          String    @db.VarChar(40)
  nombre_perfil     String?   @db.VarChar(160)
  motivo            String    @db.VarChar(40)
  telefono_contacto String?   @db.VarChar(40)
  nit_intentado     String?   @db.VarChar(40)
  notas             String?
  atendido          Boolean   @default(false)
  atendido_at       DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  visitas           visitas[]

  @@index([atendido, created_at(sort: Desc)], map: "idx_pendientes_atendido")
}

enum motivo_movimiento {
  compra
  venta
  merma
  produccion
  ajuste_manual
  reconteo
}

enum tipo_inventario {
  insumo
  materia_prima
  producto_terminado
}

enum tipo_movimiento {
  entrada
  salida
  ajuste
}

/// Día de visitas de un vendedor (se inicia y finaliza desde su app).
/// El id lo genera el celular para poder registrar sin señal.
model jornadas_visita {
  id          String    @id @db.Uuid
  vendedor_id String    @db.Uuid
  fecha       DateTime  @db.Date
  ciudad      String    @db.VarChar(120)
  inicio_at   DateTime  @db.Timestamptz(6)
  fin_at      DateTime? @db.Timestamptz(6)
  inicio_lat  Float?
  inicio_lng  Float?
  fin_lat     Float?
  fin_lng     Float?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  vendedor    usuarios  @relation(fields: [vendedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  visitas     visitas[]

  @@index([vendedor_id, fecha(sort: Desc)], map: "idx_jornadas_visita_vendedor_fecha")
}

/// Negocio visitado por un vendedor dentro de una jornada.
model visitas {
  id                    String                @id @db.Uuid
  jornada_id            String                @db.Uuid
  vendedor_id           String                @db.Uuid
  registrada_at         DateTime              @db.Timestamptz(6)
  nicho                 String                @db.VarChar(60)
  nombre_empresa        String                @db.VarChar(160)
  direccion             String?
  telefono              String?               @db.VarChar(40)
  contacto              String?               @db.VarChar(120)
  observaciones         String?
  latitud               Float?
  longitud              Float?
  precision_m           Float?
  cliente_id            String?               @db.Uuid
  contacto_pendiente_id String?               @db.Uuid
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  jornada               jornadas_visita       @relation(fields: [jornada_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendedor              usuarios              @relation(fields: [vendedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cliente               clientes?             @relation(fields: [cliente_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  contacto_pendiente    contactos_pendientes? @relation(fields: [contacto_pendiente_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([jornada_id], map: "idx_visitas_jornada")
  @@index([vendedor_id, registrada_at(sort: Desc)], map: "idx_visitas_vendedor_fecha")
}
